# Database. Use a local Postgres or your own Neon branch for development,
# never production's: migrations run on build and admin tools write to it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/archangel

# MapTiler key (free tier: https://cloud.maptiler.com/account/keys)
VITE_MAP_TOKEN=your_maptiler_key_here

# Data changes need a signed-in admin account (Admin Tools). ADMIN_SECRET is an
# optional key that scripts can send as the x-admin-secret header instead.
ADMIN_SECRET=

# Local development only: let every request write without signing in.
# ALLOW_OPEN_WRITES=1

# Server
PORT=3000
NODE_ENV=development

# Client (optional, defaults to /api in production and localhost:3000 in dev)
# VITE_API_URL=http://localhost:3000/api
