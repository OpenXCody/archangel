# Copy to .env.local and fill in. Both the server and the client read it.

# Database. A local Postgres or your own Neon branch, never production's:
# Admin Tools and `npm run db:migrate` write to it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/archangel

# MapTiler key (free tier: https://cloud.maptiler.com/account/keys).
# Without one the map draws on a plain canvas.
VITE_MAP_TOKEN=your_maptiler_key_here

# Ports. WEB_PORT is the page (default 5173), PORT the API (default 3000).
PORT=3000
# WEB_PORT=5173
NODE_ENV=development

# There is no admin key. The first admin signs up in the app and is then
# made an admin on the command line:
#   node --env-file=.env.local scripts/make-admin.mjs you@example.com

# Email (server/lib/email.ts). Mail is off unless RESEND_API_KEY and EMAIL_FROM
# are both set; with it off, invite and password reset links are passed on by hand.
# Resend API key.
# RESEND_API_KEY=
# The sender every email comes from.
# EMAIL_FROM=
# The address links in emails start from (default https://www.o-10.com).
# APP_URL=http://localhost:5173
# Outside production only: write each email to this file as one line of JSON
# instead of sending it. Counts as mail being on.
# EMAIL_OUTBOX=

# Loading factories from the Pillar database (server/scripts/import-pillar-bulk.ts).
# PILLAR_DATABASE_URL=
# IMPORT_LIMIT=50000
# IMPORT_MIN_CONFIDENCE=60
