# Database (Neon PostgreSQL). Note: this is the same database production uses.
DATABASE_URL=postgresql://user:password@host:5432/archangel?sslmode=require

# MapTiler key (free tier: https://cloud.maptiler.com/account/keys)
VITE_MAP_TOKEN=your_maptiler_key_here

# Admin key for data changes (import, create/edit/delete). Leave unset locally
# to keep writes open in dev; REQUIRED on Vercel or writes are refused.
ADMIN_SECRET=

# Server
PORT=3000
NODE_ENV=development

# Client (optional, defaults to /api in production and localhost:3000 in dev)
# VITE_API_URL=http://localhost:3000/api
