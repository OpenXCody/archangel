{
  "name": "archangel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "node scripts/migrate.mjs --build && tsc && vite build",
    "preview": "vite preview",
    "start:server": "tsx server/index.ts",
    "db:create": "node scripts/create-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx server/scripts/seed.ts",
    "lint": "eslint . --ext .ts,.tsx && node scripts/check-esm-imports.mjs && node scripts/check-theme-colors.mjs && node scripts/check-csp.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "test:ui:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/oxanium": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tanstack/react-query": "^5.50.0",
    "@tanstack/react-virtual": "^3.13.23",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.19.2",
    "lucide-react": "^0.400.0",
    "maplibre-gl": "^4.5.0",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "tailwind-merge": "^2.4.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "papaparse": "^5.4.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.51.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^6.4.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
